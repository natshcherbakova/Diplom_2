# pyenv
#   For a library or package, these are typically managed by the environment
#   and should not be committed:
# .python-version

# pipenv
#   According to pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you prefer to keep it:
# Pipfile.lock

# UV
#   Similar to Pipfile.lock, it is generally recommended to include uv.lock
#   However, if you prefer to keep it:
# uv.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock
#   However, if you prefer to keep it:
# poetry.lock
# poetry.toml

# pdm
#   PDM recommends including project-wide dependencies in version control
#   .pdm-python and build artifacts should not be committed.
.pdm-python
.pdm-build/

# pixi
#   Pixi creates a virtual environment inside the .pixi directory.
.pixi

# PEP 582; used by e.g. github.com/github/pyflow or github.com/pdm-project/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

